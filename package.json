{
  "name": "@myparcel-dev/ts-utils",
  "version": "1.15.4",
  "description": "TypeScript utilities",
  "keywords": [
    "typescript",
    "utility",
    "utils",
    "type-guard"
  ],
  "license": "MIT",
  "author": "Edie Lemoine <edie@myparcel.nl>",
  "type": "module",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "prepare": "is-ci || husky install",
    "test": "vitest",
    "test:run": "vitest run",
    "test:types": "tsc -p src/__tests__/types/tsconfig.test.json"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{json,md,yml}": "prettier --write",
    "package.json": "sort-package-json"
  },
  "prettier": "@myparcel-dev/prettier-config",
  "release": {
    "extends": "@myparcel-dev/semantic-release-config/github-npm"
  },
  "devDependencies": {
    "@myparcel-dev/eslint-config-prettier-typescript": "^1.4.0",
    "@myparcel-dev/prettier-config": "^2.0.1",
    "@myparcel-dev/semantic-release-config": "^6.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.33.0",
    "husky": "^9.1.7",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.0.0",
    "prettier": "^2.8.4",
    "sort-package-json": "^2.4.1",
    "ts-node": "^10.9.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.0.2",
  "publishConfig": {
    "access": "public"
  }
}
